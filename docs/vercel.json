{
  "framework": "astro",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/v1/",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/docs/v1/",
      "permanent": false
    }
  ]
}
