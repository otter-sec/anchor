{
  "extends": "astro/tsconfigs/strict",
  "exclude": [
    "codemod.ts",
    "sentence-case.ts",
    "dist",
    "src/content/docs/**/_*/**",
    "public/plgrnd"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
